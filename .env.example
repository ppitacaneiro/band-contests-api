# Copia este archivo a .env y ajusta los valores si es necesario:
#   cp .env.example .env
#
# El docker-compose.yml exige que POSTGRES_DB, POSTGRES_USER y POSTGRES_PASSWORD
# estén definidos (no hay valores por defecto). DATABASE_URL se construye con
# los mismos valores para mantener la coherencia.
#
# Para producción, genera secretos fuertes:
#   openssl rand -hex 32   (para POSTGRES_PASSWORD y JWT_SECRET)

POSTGRES_DB=band_contests
POSTGRES_USER=band_contests
POSTGRES_PASSWORD=dev_only_change_me
DATABASE_URL=postgresql://band_contests:dev_only_change_me@postgres:5432/band_contests?schema=public
PORT=3001
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRES_IN=7d
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000